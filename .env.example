# Copia este archivo a .env.local y llena los valores.
# Nunca subas .env.local ni las llaves reales.

# URL del proyecto de Supabase (Settings → API)
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Service role key. Solo servidor. Nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# PIN compartido de caja. El personal lo escribe en /scan.
STAFF_PIN=1234

# Secreto para firmar la cookie de sesión del personal (HMAC).
# Genera uno largo, por ejemplo: openssl rand -hex 32
LOYALTY_SECRET=
